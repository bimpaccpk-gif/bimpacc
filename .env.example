# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS: never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL, used for auth redirects/callbacks (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production signs in with Google only. Set to "true" ONLY on a staging project that needs
# email/password (always enabled when NODE_ENV=development).
# ENABLE_PASSWORD_AUTH=false

# Multi-factor authentication for EVERY signed-in user (students, instructors, admins).
# ENFORCED BY DEFAULT in production: until a user sets up an authenticator the only screen
# they can reach is /mfa; after that they use the app normally. Development defaults to off.
#   MFA_ENFORCEMENT=enforce  -> force on (e.g. to try the real flow locally)
#   MFA_ENFORCEMENT=off      -> EMERGENCY switch only (e.g. /mfa is broken and nobody can sign in)
# Lost phone? An admin uses "Reset MFA" on the user's page in /admin/users.
# MFA_ENFORCEMENT=
