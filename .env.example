# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS: never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL, used for auth redirects/callbacks (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
