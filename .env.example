# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS: never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL, used for auth redirects/callbacks (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production signs in with Google only. Set to "true" ONLY on a staging project that needs
# email/password (always enabled when NODE_ENV=development).
# ENABLE_PASSWORD_AUTH=false

# Staff (admin/instructor) multi-factor authentication. Roll out in two steps:
#   1. leave unset/"off", have every admin enroll an authenticator at /mfa
#   2. set to "enforce"
# Lost device? Remove the factor in Supabase Dashboard -> Authentication -> Users.
# STAFF_MFA_ENFORCEMENT=off
